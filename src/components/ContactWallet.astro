---
// A wallet pocket of walkthrough passes, one per app. Only each card's top strip shows above the
// front panel; hovering or focusing a card raises it to reveal what to bring. Each card is a real
// email link. Phones have no hover, so there the cards show in full in a 2x2 grid instead.
// Tints and resting positions live in the CSS below (nth-child): the CSP blocks inline style attributes.
import { passes, walkthroughMail } from '../data/site';
---
<div class="wallet">
  <div class="back" aria-hidden="true"></div>
  <div class="cards">
    {passes.map((p) => (
      <a
        class="pass"
        href={walkthroughMail(p.name)}
        aria-label={`${p.name} walkthrough pass, ${p.for.toLowerCase()}. ${p.bring} Opens an email to book a free walkthrough.`}
      >
        <span class="strip">
          <span class="tile" aria-hidden="true">{p.mark}</span>
          <span class="who"><span class="name">{p.name}</span><span class="for">{p.for}</span></span>
        </span>
        <span class="mid">
          <span class="label">Free walkthrough</span>
          <span class="bring">{p.bring}</span>
        </span>
        <span class="code" aria-hidden="true"></span>
      </a>
    ))}
  </div>
  <div class="front" aria-hidden="true"><span>Pick a pass. It opens an email to book your walkthrough.</span></div>
</div>

<style>
  .wallet {
    container-type: inline-size;
    position: relative;
    max-width: 44rem;
    padding: 13cqw 0 2cqw; /* headroom above for a raised card; the bottom pad lets resting offsets stay under the front panel */
  }
  .back {
    position: absolute;
    inset: 10cqw 0 0 0;
    border-radius: 3cqw 3cqw 2.5cqw 2.5cqw;
    background: #061231;
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.06);
  }
  .cards {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 0 2cqw;
  }
  .pass {
    position: relative;
    z-index: 1;
    flex: 0 0 27%;
    aspect-ratio: 5 / 7;
    margin-left: -3.6%;
    display: flex;
    flex-direction: column;
    padding: 2.2cqw;
    border-radius: 2cqw;
    background: var(--tint);
    color: #0b1b3d;
    text-decoration: none;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
    transform: translateY(var(--y)) rotate(var(--r));
    transform-origin: 50% 100%;
    transition: transform 587ms linear(0, 0.094 5.6%, 0.274 11.1%, 0.455 16.7%, 0.608 22.2%, 0.726 27.8%, 0.812 33.3%, 0.873 38.9%, 0.916 44.4%, 0.944 50%, 0.964 55.6%, 0.976 61.1%, 0.985 66.7%, 0.99 72.2%, 0.994 77.8%, 0.996 83.3%, 0.998 88.9%, 1 100%), box-shadow 300ms ease;
  }
  .pass:first-child { margin-left: 0; }
  .pass:nth-child(1) { --tint: #ffc447; --r: -3deg; --y: 1.2cqw; }
  .pass:nth-child(2) { --tint: #f2a565; --r: 2deg; --y: 0cqw; }
  .pass:nth-child(3) { --tint: #4fd1ad; --r: -1.5deg; --y: 1.8cqw; }
  .pass:nth-child(4) { --tint: #b9a4f3; --r: 3.5deg; --y: 0.6cqw; }
  .pass:hover,
  .pass:focus-visible {
    z-index: 5; /* above the other cards, below the front panel */
    transform: translateY(-32%) rotate(0deg);
    box-shadow: 0 18px 30px -8px rgb(0 0 0 / 0.55);
  }
  .pass:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  .strip { display: flex; align-items: center; gap: 1.6cqw; }
  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 5.4cqw;
    height: 5.4cqw;
    border-radius: 1.2cqw;
    background: #0b1f4a;
    color: var(--tint);
    font-weight: 800;
    font-size: 2.8cqw;
  }
  .who { display: grid; min-width: 0; }
  .name { font-weight: 800; font-size: 2.4cqw; line-height: 1.15; }
  .for { font-size: 1.75cqw; opacity: 0.8; }
  .mid { margin-top: 3.2cqw; display: grid; gap: 0.6cqw; }
  .label { font-size: 1.6cqw; font-weight: 700; opacity: 0.75; }
  .bring { font-size: 2.1cqw; font-weight: 600; line-height: 1.25; }
  /* Decorative barcode at the bottom of the pass. */
  .code {
    margin-top: auto;
    height: 4.5cqw;
    border-radius: 0.4cqw;
    background: repeating-linear-gradient(90deg, #0b1b3d 0 2px, transparent 2px 4px, #0b1b3d 4px 5px, transparent 5px 8px, #0b1b3d 8px 11px, transparent 11px 13px);
    opacity: 0.75;
  }

  .front {
    position: absolute;
    z-index: 10;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26cqw; /* covers the lower ~62% of a resting card plus the bottom pad */
    display: flex;
    align-items: flex-end;
    padding: 0 3.5cqw 3cqw;
    border-radius: 4cqw 4cqw 2.5cqw 2.5cqw;
    background: linear-gradient(#17306a, #12285c);
    box-shadow: 0 -6px 16px -6px rgb(0 0 0 / 0.5);
    pointer-events: none; /* never blocks hovering a card */
  }
  .front::before {
    content: '';
    position: absolute;
    left: 3cqw;
    right: 3cqw;
    top: 2cqw;
    border-top: 1.5px dashed rgb(255 255 255 / 0.35);
  }
  .front span { color: rgb(255 255 255 / 0.78); font-size: 2cqw; }

  /* Phones: no hover to raise a card, so show every pass in full. */
  @media (max-width: 639px) {
    .wallet { padding-top: 0; }
    .back, .front { display: none; }
    .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; padding: 0; }
    .pass { margin: 0; aspect-ratio: auto; min-height: 11rem; padding: 0.9rem; border-radius: 0.9rem; transform: none; }
    .pass:hover, .pass:focus-visible { transform: none; }
    .strip { gap: 0.6rem; }
    .tile { width: 2.1rem; height: 2.1rem; border-radius: 0.5rem; font-size: 1.1rem; }
    .name { font-size: 0.95rem; }
    .for { font-size: 0.75rem; }
    .mid { margin-top: 0.9rem; gap: 0.2rem; }
    .label { font-size: 0.7rem; }
    .bring { font-size: 0.85rem; }
    .code { height: 1.4rem; margin-top: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pass { transition: none; }
  }
</style>
