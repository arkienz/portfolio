---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PanelGallery from '../components/PanelGallery.astro';
import Payslip from '../components/papers/Payslip.astro';
import Receipt from '../components/papers/Receipt.astro';
import Ledger from '../components/papers/Ledger.astro';
import Notebook from '../components/papers/Notebook.astro';
import ContactWallet from '../components/ContactWallet.astro';
import { site, intro, showcases, store, tool, about, principles, walkthroughMail } from '../data/site';

const nav = [['Easy Payroll', '#payroll'], ['DevPOS', '#pos'], ['Kaha', '#store'], ['DevPAUTANG', '#store'], ['Job Hunter', '#jobhunter']];
// Each chapter is printed on the paper its app replaces. Tailwind only sees literal class names,
// so each chapter's ink and paper are mapped here.
const chapter = {
  payroll: { paper: Payslip, cols: 'lg:grid-cols-[1fr_27rem]', bar: 'border-accent', btn: 'bg-accent text-accent-ink' },
  pos: { paper: Receipt, cols: 'lg:grid-cols-[1fr_22rem]', bar: 'border-pos', btn: 'bg-pos text-pos-ink' },
} as const;
const storePaper = { kaha: Ledger, utang: Notebook } as const;
const link = 'underline decoration-4 underline-offset-[6px] hover:decoration-ink';

// Banners drawn onto the 3D tiles.
const tileImg = async (src: ImageMetadata) => (await getImage({ src, width: 1200, format: 'webp' })).src;
const [payTile, posTile] = await Promise.all(showcases.map((s) => tileImg(s.banner)));
---
<Base>
  <header class="sticky top-0 z-40 flex h-(--hdr) items-center border-b border-line bg-page/85 backdrop-blur">
    <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
      <a href="#" class="font-bold tracking-tight">{site.name}</a>
      <div class="flex items-center gap-2 sm:gap-5">
        <ul class="hidden items-center gap-5 text-sm text-muted lg:flex">
          {nav.map(([l, h]) => <li><a class="hover:text-ink" href={h}>{l}</a></li>)}
        </ul>
        <button id="theme" type="button" aria-pressed="false" class="whitespace-nowrap rounded-lg border border-line px-3 py-1.5 text-sm text-muted hover:text-ink">Dark mode</button>
        <a href="#contact" class="hidden whitespace-nowrap rounded-lg bg-ink px-3 py-1.5 text-sm font-semibold text-page sm:inline-block">Contact</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- 3D intro: a flat page of app screens tilts into a floor and breaks apart on scroll (src/scripts/floor.js) -->
    <section id="floor" class="relative">
      <div id="floor-stage" class="sticky top-(--hdr) h-[calc(100svh-var(--hdr))] overflow-hidden">
        <canvas id="floor-canvas" data-payroll={payTile} data-pos={posTile} class="absolute inset-0 block h-full w-full" aria-hidden="true"></canvas>
        <div class="pointer-events-none relative mx-auto max-w-6xl px-4 pt-6 sm:px-6 sm:pt-10">
          {intro.steps.map((s, i) => {
            const last = i === intro.steps.length - 1;
            return (
              <div class:list={['headline', i > 0 && 'absolute inset-x-4 top-6 sm:inset-x-6 sm:top-10']} aria-hidden={i > 0 && !last ? 'true' : undefined}>
                {i === 0
                  ? <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.06] tracking-tight sm:text-5xl">{s}</h1>
                  : <p class="max-w-3xl text-3xl font-extrabold leading-[1.06] tracking-tight sm:text-5xl">{s}</p>}
                {last && (
                  <div class="pointer-events-auto mt-6 flex flex-wrap gap-3">
                    <a href="#contact" class="whitespace-nowrap rounded-xl bg-accent px-6 py-3 font-bold text-accent-ink hover:brightness-95">Ask for a free demo</a>
                    <a href="#contents" class="whitespace-nowrap rounded-xl border border-line bg-page px-6 py-3 font-semibold hover:bg-card">See the apps</a>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
      <div class="floor-steps" aria-hidden="true"><div></div><div></div><div></div><div></div></div>
    </section>

    <!-- Contents: one sentence, each app name links to its chapter -->
    <section id="contents" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="sr-only">The apps</h2>
      <p class="max-w-4xl text-2xl font-semibold leading-snug tracking-tight sm:text-[2rem]">
        <a href="#payroll" class:list={[link, 'decoration-accent']}>Easy Payroll</a> for companies,
        <a href="#pos" class:list={[link, 'decoration-pos']}>DevPOS</a> for cafes,
        <a href="#store" class:list={[link, 'decoration-kaha']}>Kaha</a> for sari-sari stores and
        <a href="#store" class:list={[link, 'decoration-utang']}>DevPAUTANG</a> for neighborhood lenders. Each one replaces a piece of paper.
      </p>
    </section>

    <!-- Chapters: Easy Payroll on a payslip, DevPOS on a receipt, each with its screens -->
    {showcases.map((s) => {
      const c = chapter[s.id as keyof typeof chapter];
      return (
        <section id={s.id} class="border-t border-line py-16 sm:py-24">
          <div class:list={['mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:items-start', c.cols]}>
            <div>
              <h2 class="text-4xl font-extrabold tracking-tight sm:text-6xl">{s.name}</h2>
              <p class="mt-4 max-w-xl text-lg text-muted">{s.blurb}</p>
              <ul class="mt-8 max-w-xl space-y-3">
                {s.points.map((p) => <li class:list={['border-l-4 pl-4', c.bar]}>{p}</li>)}
              </ul>
              <a href={walkthroughMail(s.name)} class:list={['mt-8 inline-block whitespace-nowrap rounded-xl px-5 py-2.5 font-bold hover:brightness-95', c.btn]}>{s.cta}</a>
            </div>
            <c.paper />
          </div>
          <div class="mx-auto mt-14 max-w-6xl px-4 sm:px-6">
            <PanelGallery label={`${s.name} screens`} shots={s.shots} />
            <p class="mt-3 text-xs text-muted">{s.note}</p>
          </div>
        </section>
      );
    })}

    <!-- Kaha on a ledger page, DevPAUTANG on a notebook page -->
    <section id="store" class="border-t border-line py-16 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-16 px-4 sm:px-6 lg:grid-cols-2">
        {store.map((a) => {
          const Paper = storePaper[a.id as keyof typeof storePaper];
          return (
            <div>
              <h2 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{a.name}</h2>
              <p class="mt-4 text-muted">{a.text}</p>
              <div class="mt-8"><Paper /></div>
              <p class="mt-6 text-sm text-muted">{a.status}</p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Job Hunter: a tool for my own job hunt, with its screens and a link to the showcase repo -->
    <section id={tool.id} class="border-t border-line py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-muted">Built for my own job hunt</p>
        <h2 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-6xl">{tool.name}</h2>
        <p class="mt-4 max-w-2xl text-lg text-muted">{tool.blurb}</p>
        <ul class="mt-8 grid max-w-4xl gap-3 sm:grid-cols-2">
          {tool.points.map((p) => <li class="border-l-4 border-hunt pl-4">{p}</li>)}
        </ul>
        <a href={tool.link} rel="noopener" class="mt-8 inline-block whitespace-nowrap rounded-xl bg-hunt px-5 py-2.5 font-bold text-hunt-ink hover:brightness-95">See how it's built on GitHub</a>
        <div class="mt-14">
          <PanelGallery label={`${tool.name} screens`} shots={tool.shots} />
          <p class="mt-3 text-xs text-muted">{tool.note}</p>
        </div>
      </div>
    </section>

    <!-- Who is behind it -->
    <section id="about" class="border-t border-line py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="sr-only">About</h2>
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-tight sm:text-[2rem]">{about}</p>
        <dl class="mt-10 grid max-w-4xl gap-6 text-sm sm:grid-cols-3">
          {principles.map((p) => <div><dt class="font-bold">{p.t}</dt><dd class="mt-1 text-muted">{p.d}</dd></div>)}
        </dl>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
      <div class="grid gap-10 rounded-3xl bg-navy p-6 text-white sm:p-14 lg:grid-cols-[1fr_1.15fr] lg:items-end">
        <div>
          <h2 class="max-w-xl text-3xl font-extrabold tracking-tight sm:text-5xl">See it run on <span class="mark" data-mark-target>your own data.</span></h2>
          <p class="mt-4 max-w-md text-white/75">Pick a pass and I'll set up a free walkthrough on your real cutoff, menu or ledger.</p>
          <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            <div><dt class="text-sm text-white/65">Email</dt><dd class="text-lg"><a class="underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt class="text-sm text-white/65">Phone</dt><dd class="text-lg"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></dd></div>
            <div><dt class="text-sm text-white/65">GitHub</dt><dd class="text-lg"><a class="underline-offset-4 hover:underline" href={site.github} rel="noopener">github.com/arkienz</a></dd></div>
          </dl>
        </div>
        <ContactWallet />
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-8 text-center text-xs text-muted">
    <p>&copy; {new Date().getFullYear()} {site.name}. Easy Payroll, DevPOS, Kaha, DevPAUTANG and Job Hunter are my own products, not affiliated with or endorsed by GCash, G-Xchange, Inc., QR Ph, the Bangko Sentral ng Pilipinas, SSS, PhilHealth, Pag-IBIG, BIR, DOLE, onlinejobs.ph, Telegram or Anthropic. Their names are used only to describe what the apps work with.</p>
    <p class="mt-2">
      <a href="/privacy/" class="underline-offset-4 hover:text-ink hover:underline">Privacy notice</a>.
      <a href="/licenses.txt" class="underline-offset-4 hover:text-ink hover:underline">Open-source licenses</a>.
      Font: Plus Jakarta Sans, <a href="/fonts/OFL.txt" class="underline-offset-4 hover:text-ink hover:underline">SIL Open Font License</a>.
    </p>
  </footer>
</Base>

<script>
  // Separate chunk so the rest of the page's script stays small.
  import('../scripts/floor.js');

  // Marker highlight: start undrawn, sweep in once the heading is on screen.
  const marks = document.querySelectorAll<HTMLElement>('[data-mark-target]');
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (e.isIntersecting) { (e.target as HTMLElement).dataset.mark = 'on'; io.unobserve(e.target); }
  }), { threshold: 0.6 });
  marks.forEach((m) => { m.dataset.mark = 'off'; io.observe(m); });
</script>
