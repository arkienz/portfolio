---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site, showcases } from '../data/site';
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// JPEG because some social crawlers still skip WebP previews.
const ogImage = new URL((await getImage({ src: showcases[0].banner, width: 1200, format: 'jpg' })).src, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/PlusJakartaSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Easy Payroll banner" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Set theme before paint to avoid a flash; try/catch because storage can be blocked.
      try {
        var t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink">Skip to content</a>
    <slot />
    <script>
      // The button names the mode it switches to, so its visible text is its accessible name.
      const themeBtn = document.getElementById('theme');
      const showTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (themeBtn) { themeBtn.textContent = dark ? 'Light mode' : 'Dark mode'; themeBtn.setAttribute('aria-pressed', String(dark)); }
      };
      showTheme();
      themeBtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        showTheme();
      });
    </script>
  </body>
</html>
