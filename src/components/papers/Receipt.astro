---
import { peso, sum, vatSplit } from './money';

// The Demo Cafe order from the DevPOS marketing set, in centavos.
const items: { qty: number; name: string; note?: string; amount: number }[] = [
  { qty: 2, name: 'Iced Latte', note: 'Large, oat milk', amount: 37000 },
  { qty: 1, name: 'Ensaymada', amount: 6000 },
  { qty: 1, name: 'Breakfast Set', note: 'Club sandwich, iced latte', amount: 24900 },
];
const total = sum(items.map((i) => i.amount));
const { vatable, vat } = vatSplit(total);
const cash = 70000;
---
<figure class="paper receipt tilt-l p-6 text-[0.92rem]" aria-label="Sample cafe receipt">
  <p class="text-center text-lg font-extrabold">Demo Cafe</p>
  <p class="text-center text-xs text-paper-muted">Order #12, Maria, dine in</p>
  <p class="mt-3 text-center"><span class="rounded-full bg-[#fde2e2] px-2.5 py-0.5 text-xs font-semibold text-[#9b1c1c]">No internet, still selling</span></p>
  <dl class="num dash mt-4 space-y-2 pt-4">
    {items.map((i) => (
      <div>
        <div class="flex justify-between"><dt>{i.qty} × {i.name}</dt><dd>{peso(i.amount)}</dd></div>
        {i.note && <p class="text-xs text-paper-muted">{i.note}</p>}
      </div>
    ))}
  </dl>
  <div class="num dash mt-4 space-y-1 pt-4">
    <div class="flex items-baseline justify-between"><span class="font-bold">Total</span><span class="text-2xl font-extrabold">₱{peso(total)}</span></div>
    <div class="flex justify-between text-xs text-paper-muted"><span>VATable sales</span><span>{peso(vatable)}</span></div>
    <div class="flex justify-between text-xs text-paper-muted"><span>VAT 12%</span><span>{peso(vat)}</span></div>
    <div class="flex justify-between text-xs text-paper-muted"><span>Cash</span><span>{peso(cash)}</span></div>
    <div class="flex justify-between text-xs text-paper-muted"><span>Change</span><span>{peso(cash - total)}</span></div>
  </div>
  <figcaption class="mt-4 text-center text-xs text-paper-muted">Sample data. Not an official receipt.</figcaption>
</figure>
