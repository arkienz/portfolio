---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found | ${site.name}`} description="This page does not exist.">
  <main id="main" class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-start justify-center px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold text-link">404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">This page doesn't exist.</h1>
    <p class="mt-3 text-muted">The link may be old or mistyped.</p>
    <a href="/" class="mt-8 whitespace-nowrap rounded-xl bg-accent px-6 py-3 font-bold text-accent-ink hover:brightness-95">Back to home</a>
  </main>
</Base>
