---
// Expanding image panels: the hovered, focused or tapped panel widens, the others stay narrow.
// The active panel is wide enough to show the whole picture, so no separate viewer is needed.
import { Image } from 'astro:assets';

interface Props {
  label: string;
  shots: { src: ImageMetadata; alt: string; title: string; sub: string }[];
}
const { label, shots } = Astro.props;
---
<div class="panels" role="group" aria-label={label} data-panels>
  {shots.map((s, i) => (
    <button type="button" class="panel" aria-expanded={i === 0 ? 'true' : 'false'}>
      <Image src={s.src} alt={s.alt} widths={[480, 900]} sizes="(min-width: 640px) 440px, 100vw" loading="lazy" />
      <span class="scrim" aria-hidden="true"></span>
      <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span class="caption">
        <span class="title">{s.title}</span>
        <span class="sub">{s.sub}</span>
      </span>
    </button>
  ))}
</div>

<style>
  .panels {
    --h: 34rem;
    display: flex;
    gap: 6px;
    height: var(--h);
  }
  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-navy);
    cursor: pointer;
    text-align: left;
    transition: flex-grow 800ms ease;
    /* Critically damped spring; browsers without linear() keep the ease above. */
    transition-timing-function: linear(0, 0.094 5.6%, 0.274 11.1%, 0.455 16.7%, 0.608 22.2%, 0.726 27.8%, 0.812 33.3%, 0.873 38.9%, 0.944 50%, 0.976 61.1%, 1 100%);
  }
  .panel[aria-expanded='true'] { flex-grow: 5; }

  /* Fixed image size (4:5 posts at the container height), centered: widening reveals it, never rescales it. */
  .panel :global(img) {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: calc(var(--h) * 0.8);
    max-width: none;
    object-fit: cover;
    transform: translateX(-50%);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 10 25 / 0.88), rgb(5 10 25 / 0.35) 30%, transparent 55%);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .num {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.15rem 0.45rem;
    border-radius: 0.4rem;
    background: rgb(5 10 25 / 0.7);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    transition: opacity 200ms ease;
  }
  .caption {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.25rem;
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 300ms ease, transform 300ms ease;
  }
  .title { font-size: 1.25rem; font-weight: 800; line-height: 1.2; }
  .sub { font-size: 0.875rem; color: rgb(255 255 255 / 0.82); }

  .panel[aria-expanded='true'] .scrim { opacity: 1; }
  .panel[aria-expanded='true'] .num { opacity: 0; }
  .panel[aria-expanded='true'] .caption { opacity: 1; transform: none; transition-delay: 150ms; }

  .panel:focus-visible { outline: 3px solid var(--color-link); outline-offset: 3px; }

  /* Phones: stack vertically; the open panel grows in height instead. */
  @media (max-width: 639px) {
    /* Tall enough that the open panel (5 of 10 shares) fits a full-width 4:5 picture. */
    .panels { flex-direction: column; height: 56rem; }
    .panel :global(img) { top: 50%; left: 0; width: 100%; height: auto; aspect-ratio: 4 / 5; transform: translateY(-50%); }
    .num { left: auto; right: 0.75rem; bottom: 50%; transform: translateY(50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .scrim, .num, .caption { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-panels]').forEach((group) => {
    const panels = [...group.querySelectorAll<HTMLButtonElement>('.panel')];
    const open = (p: HTMLButtonElement) => panels.forEach((q) => q.setAttribute('aria-expanded', String(q === p)));
    for (const p of panels) {
      p.addEventListener('pointerenter', () => open(p));
      p.addEventListener('focus', () => open(p));
      // click also covers Enter and Space, since each panel is a real button.
      p.addEventListener('click', () => open(p));
    }
  });
</script>
